<Window x:Class="HMIImageExport.App.ImageViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1000" Height="640" MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" KeyDown="Window_KeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Image x:Name="img_View" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock x:Name="tb_Missing" Style="{StaticResource MutedText}" HorizontalAlignment="Center"
               VerticalAlignment="Center" Visibility="Collapsed"/>
    <TextBlock x:Name="tb_Caption" Grid.Row="1" Style="{StaticResource MutedText}" Margin="12,4,12,8"/>
  </Grid>
</Window>
