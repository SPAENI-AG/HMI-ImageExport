<Window x:Class="HMIImageExport.App.WordExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:HMIImageExport.App.Infrastructure"
        Title="{l:Tr Word_DialogTitle}" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="16">
    <TextBlock Text="{l:Tr Word_Anlage}" Margin="0,0,0,4"/>
    <TextBox x:Name="tb_Anlage" Margin="0,0,0,10"/>
    <TextBlock Text="{l:Tr Word_Project}" Margin="0,0,0,4"/>
    <TextBox x:Name="tb_Project" Margin="0,0,0,10"/>
    <CheckBox x:Name="chk_Caption" Content="{l:Tr Word_Caption}"/>
    <CheckBox x:Name="chk_Cover" Content="{l:Tr Word_Cover}"/>
    <CheckBox x:Name="chk_Landscape" Content="{l:Tr Word_Landscape}" Margin="0,3,0,14"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{l:Tr Common_Ok}" Style="{StaticResource PrimaryButton}" IsDefault="True"
              MinWidth="80" Margin="0,0,8,0" Click="bt_Ok_Click"/>
      <Button Content="{l:Tr Common_Cancel}" IsCancel="True" MinWidth="80"/>
    </StackPanel>
  </StackPanel>
</Window>
