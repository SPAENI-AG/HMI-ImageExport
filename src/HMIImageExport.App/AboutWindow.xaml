<Window x:Class="HMIImageExport.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:HMIImageExport.App.Infrastructure"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24">
    <!-- <Image Source="Assets/icon.png" Width="64" Height="64" Margin="0,0,0,12"/> sobald vorhanden -->
    <TextBlock x:Name="tb_Title" FontSize="20" FontWeight="Bold"/>
    <TextBlock x:Name="tb_Version" Style="{StaticResource MutedText}" Margin="0,2,0,12"/>
    <TextBlock x:Name="tb_Copyright"/>
    <TextBlock x:Name="tb_Company" Margin="0,0,0,12"/>
    <TextBlock x:Name="tb_Developer" Margin="0,0,0,12"/>
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="{l:Tr About_Support}" Margin="0,0,6,0"/>
      <TextBlock><Hyperlink x:Name="hl_SupportUrl" Click="hl_Click"/></TextBlock>
    </StackPanel>
    <TextBlock Margin="0,2,0,12"><Hyperlink x:Name="hl_SupportMail" Click="hl_Click"/></TextBlock>
    <TextBlock Text="{l:Tr About_License}" Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
    <Button Content="{l:Tr Common_Close}" Style="{StaticResource PrimaryButton}"
            HorizontalAlignment="Right" IsDefault="True" IsCancel="True"/>
  </StackPanel>
</Window>
