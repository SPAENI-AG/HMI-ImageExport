<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>HMIImageExport</AssemblyName>
    <RootNamespace>HMIImageExport.App</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <ProjectReference Include="..\HMIImageExport.Core\HMIImageExport.Core.csproj" />
    <ProjectReference Include="..\HMIImageExport.Export\HMIImageExport.Export.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\icon.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Help\**\*" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Help')" />
  </ItemGroup>
</Project>
