<Window x:Class="HMIImageExport.App.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:HMIImageExport.App.Infrastructure"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="16">
    <TextBlock x:Name="tb_Prompt" Margin="0,0,0,6"/>
    <TextBox x:Name="tb_Input" Margin="0,0,0,14"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="bt_Ok" Content="{l:Tr Common_Ok}" Style="{StaticResource PrimaryButton}"
              IsDefault="True" MinWidth="80" Margin="0,0,8,0" Click="bt_Ok_Click"/>
      <Button Content="{l:Tr Common_Cancel}" IsCancel="True" MinWidth="80"/>
    </StackPanel>
  </StackPanel>
</Window>
