<Window x:Class="HMIImageExport.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:HMIImageExport.App.Infrastructure"
        xmlns:views="clr-namespace:HMIImageExport.App.Views"
        Title="HMI-ImageExport" Width="1080" Height="900" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Menu Grid.Row="0">
      <MenuItem Header="{l:Tr Menu_File}">
        <MenuItem x:Name="mi_Open" Header="{l:Tr Menu_Open}" InputGestureText="Ctrl+O" Click="mi_Open_Click"/>
        <Separator/>
        <MenuItem x:Name="mi_Exit" Header="{l:Tr Menu_Exit}" Click="mi_Exit_Click"/>
      </MenuItem>
      <MenuItem Header="{l:Tr Menu_Edit}">
        <MenuItem x:Name="mi_Settings" Header="{l:Tr Menu_Settings}" Click="mi_Settings_Click"/>
      </MenuItem>
      <MenuItem Header="{l:Tr Menu_View}">
        <MenuItem Header="{l:Tr Menu_Language}">
          <MenuItem x:Name="mi_LangDe" Header="{l:Tr Lang_De}" IsCheckable="True" Click="mi_Lang_Click" Tag="de"/>
          <MenuItem x:Name="mi_LangEn" Header="{l:Tr Lang_En}" IsCheckable="True" Click="mi_Lang_Click" Tag="en"/>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="{l:Tr Menu_Help}">
        <MenuItem Header="{l:Tr Menu_HelpOpen}" InputGestureText="F1" Click="mi_Help_Click"/>
        <MenuItem Header="{l:Tr Menu_Quickstart}" Tag="quickstart" Click="mi_Help_Click"/>
        <MenuItem Header="{l:Tr Menu_Troubleshooting}" Tag="troubleshooting" Click="mi_Help_Click"/>
        <MenuItem Header="{l:Tr Menu_Install}" Tag="install" Click="mi_Help_Click"/>
        <Separator/>
        <MenuItem Header="{l:Tr Menu_CheckUpdates}" Click="mi_CheckUpdates_Click"/>
        <MenuItem Header="{l:Tr Menu_OpenSettingsFolder}" Click="mi_SettingsFolder_Click"/>
        <Separator/>
        <MenuItem x:Name="mi_About" Header="{l:Tr Menu_About}" Click="mi_About_Click"/>
      </MenuItem>
    </Menu>

    <!-- Update-Banner (Schritt 6) -->
    <Border x:Name="bd_UpdateBanner" Grid.Row="1" Visibility="Collapsed"
            Background="{StaticResource AccentLightBrush}" Padding="12,6">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="✕" Padding="8,2" Margin="6,0,0,0" Click="bt_UpdateClose_Click"/>
        <Button DockPanel.Dock="Right" Content="{l:Tr Update_Skip}" Margin="6,0,0,0" Click="bt_UpdateSkip_Click"/>
        <Button DockPanel.Dock="Right" Content="{l:Tr Update_Notes}" Margin="6,0,0,0" Click="bt_UpdateNotes_Click"/>
        <Button DockPanel.Dock="Right" Content="{l:Tr Update_Download}" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Click="bt_UpdateDownload_Click"/>
        <TextBlock x:Name="tb_UpdateText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>

    <TabControl x:Name="tc_Main" Grid.Row="2" Margin="12,4,12,8">
      <TabItem x:Name="ti_Capture" Header="{l:Tr Tab_Capture}">
        <views:CaptureView x:Name="view_Capture"/>
      </TabItem>
      <TabItem x:Name="ti_Settings" Header="{l:Tr Tab_Settings}">
        <views:SettingsView x:Name="view_Settings"/>
      </TabItem>
    </TabControl>

    <Border Grid.Row="3" Background="{StaticResource FooterBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,4">
      <DockPanel>
        <TextBlock x:Name="tb_FooterVersion" DockPanel.Dock="Right" FontSize="11"
                   Foreground="{StaticResource MutedBrush}"/>
        <TextBlock x:Name="tb_FooterCompany" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
