<UserControl x:Class="HMIImageExport.App.Views.CaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:HMIImageExport.App.Infrastructure">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <GroupBox Grid.Column="0" Margin="0,0,5,10">
        <GroupBox.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{l:Tr Conn_Title}" VerticalAlignment="Center"/>
            <Button Style="{StaticResource HelpButton}" Tag="connect" Margin="8,0,0,0"/>
          </StackPanel>
        </GroupBox.Header>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="70"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="1" Text="{l:Tr Conn_Host}" Style="{StaticResource FormLabel}"/>
          <TextBox x:Name="tb_Host" Grid.Row="1" Grid.Column="1" Margin="0,0,10,6"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="{l:Tr Conn_Port}" Style="{StaticResource FormLabel}"/>
          <TextBox x:Name="tb_Port" Grid.Row="1" Grid.Column="3" Text="5900" Margin="0,0,0,6"/>
          <TextBlock Grid.Row="2" Text="{l:Tr Conn_Password}" Style="{StaticResource FormLabel}"/>
          <PasswordBox x:Name="pb_Password" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8"/>
          <TextBlock Grid.Row="0" Text="{l:Tr Conn_Profile}" Style="{StaticResource FormLabel}"/>
          <ComboBox x:Name="cb_Profile" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" DisplayMemberPath="Name"
                    SelectionChanged="cb_Profile_SelectionChanged" Margin="0,0,0,6"/>
          <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Orientation="Horizontal">
            <Button x:Name="bt_Connect" Content="{l:Tr Conn_Connect}" Style="{StaticResource PrimaryButton}"
                    Click="bt_Connect_Click" MinWidth="110"/>
            <Button x:Name="bt_Disconnect" Content="{l:Tr Conn_Disconnect}" Click="bt_Disconnect_Click"
                    MinWidth="110" Visibility="Collapsed"/>
            <TextBlock x:Name="tb_Status" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
          </StackPanel>
        </Grid>
      </GroupBox>

      <GroupBox Grid.Column="1" Margin="5,0,0,10">
        <GroupBox.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{l:Tr Folder_Title}" VerticalAlignment="Center"/>
            <Button Style="{StaticResource HelpButton}" Tag="folder" Margin="8,0,0,0"/>
          </StackPanel>
        </GroupBox.Header>
        <StackPanel>
          <TextBlock x:Name="tb_Folder" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="bt_Folder" Content="{l:Tr Folder_Choose}" Click="bt_Folder_Click" Margin="0,0,8,0"/>
            <Button x:Name="bt_Word" Content="{l:Tr Word_Create}" Style="{StaticResource PrimaryButton}" Click="bt_Word_Click"/>
          </StackPanel>
        </StackPanel>
      </GroupBox>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="300"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition x:Name="col_Right" Width="360" MinWidth="280" MaxWidth="800"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
              BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
        <Grid>
          <Image x:Name="img_Panel" Stretch="Uniform" MouseLeftButtonDown="img_Panel_MouseLeftButtonDown"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock x:Name="tb_PanelHint" Text="{l:Tr Panel_Hint}" Style="{StaticResource MutedText}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="Transparent" ShowsPreview="False" ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Columns" Cursor="SizeWE" Margin="0,0,0,10" DragCompleted="split_DragCompleted"/>

      <GroupBox Grid.Column="2">
        <GroupBox.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{l:Tr Pages_Title}" VerticalAlignment="Center"/>
            <Button Style="{StaticResource HelpButton}" Tag="pages" Margin="8,0,0,0"/>
          </StackPanel>
        </GroupBox.Header>
        <DockPanel>
          <Button x:Name="bt_Save" DockPanel.Dock="Top" Content="{l:Tr Pages_Save}" Style="{StaticResource PrimaryButton}"
                  Click="bt_Save_Click" Margin="0,0,0,8"/>
          <Expander DockPanel.Dock="Top" Margin="0,0,0,8" IsExpanded="False">
            <Expander.Header>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{l:Tr Lang_Section}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource HelpButton}" Tag="languages" Margin="8,0,0,0"/>
              </StackPanel>
            </Expander.Header>
            <StackPanel Margin="0,8,0,0">
              <CheckBox x:Name="chk_Multi" Content="{l:Tr Lang_Enable}" Click="Lang_Changed"/>
              <TextBlock Text="{l:Tr Lang_List}" Style="{StaticResource MutedText}" FontSize="11"
                         TextWrapping="Wrap" Margin="0,6,0,2"/>
              <TextBox x:Name="tb_Languages" LostFocus="Lang_Changed"/>
              <TextBlock Text="{l:Tr Lang_Select}" Margin="0,8,0,2"/>
              <ItemsControl x:Name="ic_LangSelect">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding Code}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Margin="0,0,12,2" Click="Lang_Changed"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{l:Tr Lang_Current}" Margin="0,8,0,2"/>
              <ComboBox x:Name="cb_StartLang"/>
              <WrapPanel Margin="0,8,0,0">
                <Button x:Name="bt_LangPick" Content="{l:Tr Lang_SetButton}" Click="bt_LangPick_Click" Margin="0,0,6,6"/>
                <Button x:Name="bt_LangTest" Content="{l:Tr Lang_Test}" Click="bt_LangTest_Click" Margin="0,0,0,6"/>
              </WrapPanel>
              <TextBlock x:Name="tb_FlagPos" Style="{StaticResource MutedText}" FontSize="11"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="{l:Tr Lang_Wait}" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="tb_LangWait" Width="60" LostFocus="Lang_Changed"/>
              </StackPanel>
            </StackPanel>
          </Expander>
          <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="bt_Rename" Content="{l:Tr Pages_Rename}" Click="bt_Rename_Click" Margin="0,0,6,6"/>
            <Button x:Name="bt_Retake" Content="{l:Tr Pages_Retake}" Click="bt_Retake_Click" Margin="0,0,6,6"/>
            <Button x:Name="bt_Remove" Content="{l:Tr Pages_Remove}" Click="bt_Remove_Click" Margin="0,0,6,6"/>
            <Button x:Name="bt_Up" Content="{l:Tr Pages_Up}" Click="bt_Up_Click" Margin="0,0,6,6" MinWidth="32"/>
            <Button x:Name="bt_Down" Content="{l:Tr Pages_Down}" Click="bt_Down_Click" Margin="0,0,0,6" MinWidth="32"/>
          </WrapPanel>
          <Grid>
            <ListBox x:Name="lb_Pages" AllowDrop="True" HorizontalContentAlignment="Stretch"
                     BorderBrush="{StaticResource LineBrush}" SelectionChanged="lb_Pages_SelectionChanged"
                     PreviewMouseLeftButtonDown="lb_Pages_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="lb_Pages_PreviewMouseMove" Drop="lb_Pages_Drop"
                     MouseDoubleClick="lb_Pages_MouseDoubleClick">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="100"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Thumbnail}" Width="96" Height="60" Stretch="Uniform"/>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Info}" Style="{StaticResource MutedText}" FontSize="11"
                                 TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="tb_PagesEmpty" Text="{l:Tr Pages_Empty}" Style="{StaticResource MutedText}"
                       TextWrapping="Wrap" Margin="12" IsHitTestVisible="False" VerticalAlignment="Top"/>
          </Grid>
        </DockPanel>
      </GroupBox>
    </Grid>
  </Grid>
</UserControl>
