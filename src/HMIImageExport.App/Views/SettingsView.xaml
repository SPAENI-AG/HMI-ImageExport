<UserControl x:Class="HMIImageExport.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:HMIImageExport.App.Infrastructure">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <GroupBox Grid.Column="0" Margin="0,0,10,10">
      <GroupBox.Header>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{l:Tr Set_Profiles}" VerticalAlignment="Center"/>
          <Button Style="{StaticResource HelpButton}" Tag="settings" Margin="8,0,0,0"/>
        </StackPanel>
      </GroupBox.Header>
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
          <Button x:Name="bt_New" Content="{l:Tr Set_New}" Click="bt_New_Click" Margin="0,0,6,0"/>
          <Button x:Name="bt_Delete" Content="{l:Tr Set_Delete}" Click="bt_Delete_Click"/>
        </StackPanel>
        <ListBox x:Name="lb_Profiles" DisplayMemberPath="Name" MinHeight="200"
                 BorderBrush="{StaticResource LineBrush}" SelectionChanged="lb_Profiles_SelectionChanged"/>
      </DockPanel>
    </GroupBox>

    <StackPanel Grid.Column="1">
      <GroupBox Header="{l:Tr Set_Profile}">
        <Grid x:Name="grid_Profile">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{l:Tr Set_Name}" Style="{StaticResource FormLabel}" Margin="0,0,12,6"/>
          <TextBox x:Name="tb_Name" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"/>
          <TextBlock Grid.Row="1" Text="{l:Tr Conn_Host}" Style="{StaticResource FormLabel}" Margin="0,0,12,6"/>
          <TextBox x:Name="tb_Host" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"/>
          <TextBlock Grid.Row="2" Text="{l:Tr Conn_Port}" Style="{StaticResource FormLabel}" Margin="0,0,12,6"/>
          <TextBox x:Name="tb_Port" Grid.Row="2" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"/>
          <TextBlock Grid.Row="3" Text="{l:Tr Conn_Password}" Style="{StaticResource FormLabel}" Margin="0,0,12,6"/>
          <PasswordBox x:Name="pb_Password" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{l:Tr Set_PasswordNote}" Style="{StaticResource MutedText}"
                     TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"/>
          <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="bt_Save" Content="{l:Tr Set_Save}" Style="{StaticResource PrimaryButton}" Click="bt_Save_Click"/>
            <TextBlock x:Name="tb_Status" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
          </StackPanel>
        </Grid>
      </GroupBox>
      <Button Content="{l:Tr Set_Folder}" Click="bt_SettingsFolder_Click" HorizontalAlignment="Left"/>
    </StackPanel>
  </Grid>
</UserControl>
